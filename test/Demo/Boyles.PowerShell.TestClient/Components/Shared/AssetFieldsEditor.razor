<div class="mb-2 d-flex justify-content-between align-items-center">
    <label class="form-label mb-0">Custom fields</label>
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddField">
        <i class="ti ti-plus me-1"></i>Add field
    </button>
</div>

@if (Fields.Count == 0)
{
    <div class="text-secondary small mb-2">No custom fields yet - click "Add field" to set a value on the asset's layout fields.</div>
}

@foreach (var field in Fields)
{
    <div class="row g-2 mb-2" @key="field.Key">
        <div class="col-md-5">
            <input class="form-control form-control-sm" placeholder="Label (matches the asset layout field)" @bind="field.Label" />
        </div>
        <div class="col-md-6">
            <input class="form-control form-control-sm" placeholder="Value" @bind="field.Value" />
        </div>
        <div class="col-md-1 d-flex align-items-center justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveField(field)" title="Remove field">
                <i class="ti ti-trash"></i>
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<AssetFieldRow> Fields { get; set; } = new();

    private void AddField() => Fields.Add(new AssetFieldRow());

    private void RemoveField(AssetFieldRow field) => Fields.Remove(field);
}
