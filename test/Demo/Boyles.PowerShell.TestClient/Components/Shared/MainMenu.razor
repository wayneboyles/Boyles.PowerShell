@using Boyles.PowerShell.TestClient.Menu

@* Rendered entirely from MenuDefinition.Items - add or change menu entries there, not here. *@

<div class="navbar-expand-md">
    <div class="collapse navbar-collapse" id="navbar-menu">
        <div class="navbar">
            <div class="container-xl">
                <div class="row flex-column flex-md-row flex-fill align-items-center">
                    <div class="col">
                        <nav aria-label="Primary">
                            <ul class="navbar-nav">
                                @foreach (var item in MenuItem.Sort(MenuDefinition.Items))
                                {
                                    if (!item.HasChildren)
                                    {
                                        <li class="nav-item">
                                            <NavLink class="nav-link" href="@item.Url" Match="@(item.Url == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                                @if (item.Icon is not null)
                                                {
                                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@item.Icon"></i></span>
                                                }
                                                <span class="nav-link-title">@item.DisplayName</span>
                                            </NavLink>
                                        </li>
                                        continue;
                                    }

                                    var links = item.SortedChildren.Where(c => !c.HasChildren).ToList();
                                    var columns = SplitIntoColumns(item.SortedChildren.Where(c => c.HasChildren).ToList());

                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-haspopup="true" aria-expanded="false">
                                            @if (item.Icon is not null)
                                            {
                                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@item.Icon"></i></span>
                                            }
                                            <span class="nav-link-title">@item.DisplayName</span>
                                        </a>
                                        <div class="dropdown-menu">
                                            <div class="dropdown-menu-columns">
                                                @for (var i = 0; i < Math.Max(columns.Count, 1); i++)
                                                {
                                                    <div class="dropdown-menu-column">
                                                        @if (i == 0)
                                                        {
                                                            foreach (var link in links)
                                                            {
                                                                <NavLink class="dropdown-item" href="@link.Url">
                                                                    @if (link.Icon is not null)
                                                                    {
                                                                        <i class="@link.Icon me-2"></i>
                                                                    }
                                                                    @link.DisplayName
                                                                </NavLink>
                                                            }

                                                            if (links.Count > 0 && columns.Count > 0)
                                                            {
                                                                <div class="dropdown-divider"></div>
                                                            }
                                                        }

                                                        @if (i < columns.Count)
                                                        {
                                                            foreach (var group in columns[i])
                                                            {
                                                                <div class="dropdown-submenu">
                                                                    <a class="dropdown-item dropdown-toggle" href="#" @onclick:preventDefault>
                                                                        @if (group.Icon is not null)
                                                                        {
                                                                            <i class="@group.Icon me-2"></i>
                                                                        }
                                                                        @group.DisplayName
                                                                    </a>
                                                                    <div class="dropdown-menu">
                                                                        @foreach (var child in group.SortedChildren)
                                                                        {
                                                                            <NavLink class="dropdown-item" href="@child.Url">@child.DisplayName</NavLink>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Maximum number of columns a dropdown's submenus are spread across.
    /// </summary>
    private const int MaxColumns = 2;

    /// <summary>
    /// Splits a dropdown's submenus into up to <see cref="MaxColumns"/> columns of near-equal length,
    /// filling each column top-to-bottom so alphabetical order reads down the first column, then the next.
    /// </summary>
    private static List<MenuItem[]> SplitIntoColumns(List<MenuItem> groups)
    {
        if (groups.Count == 0)
        {
            return new List<MenuItem[]>();
        }

        var perColumn = (int)Math.Ceiling(groups.Count / (double)MaxColumns);
        return groups.Chunk(perColumn).ToList();
    }
}
