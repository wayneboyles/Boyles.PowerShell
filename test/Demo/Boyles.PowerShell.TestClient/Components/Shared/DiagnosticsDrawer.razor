<div class="offcanvas offcanvas-end" tabindex="-1" id="diagnosticsPanel" aria-labelledby="diagnosticsPanelLabel" style="width: 560px; max-width: 100vw;">
    <div class="offcanvas-header border-bottom">
        <h2 class="offcanvas-title" id="diagnosticsPanelLabel"><i class="ti ti-activity me-2"></i>HTTP Diagnostics</h2>
        <div class="ms-auto d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="Store.Clear" disabled="@(Store.Records.Count == 0)">
                <i class="ti ti-trash me-1"></i>Clear
            </button>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
    </div>
    <div class="offcanvas-body p-0">
        @{
            var records = Store.Records;
        }
        @if (records.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon"><i class="ti ti-api-off" style="font-size: 2.5rem;"></i></div>
                <p class="empty-title">No calls yet</p>
                <p class="empty-subtitle text-secondary">
                    Run any Hudu action and its full request/response trail - including retries
                    and 401 re-auth cycles - will show up here.
                </p>
            </div>
        }
        else
        {
            <div class="accordion accordion-flush" id="diagnosticsAccordion">
                @foreach (var record in records)
                {
                    var elementId = (record.CallId ?? Guid.NewGuid()).ToString("N");

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#call-@elementId">
                                <span class="badge @MethodBadgeClass(record.HttpMethod) me-2">@(record.HttpMethod ?? "?")</span>
                                <span class="badge @StatusBadgeClass(record) me-2">@(record.ResponseStatusCode?.ToString() ?? "ERR")</span>
                                <span class="text-truncate" style="max-width: 200px;" title="@record.RequestUri">@Label(record)</span>
                                @if (record.IsRetry == true)
                                {
                                    <span class="badge bg-yellow-lt ms-2">retry</span>
                                }
                                <span class="text-secondary ms-auto me-2 small">@FormatDuration(record.DurationMs)</span>
                            </button>
                        </h2>
                        <div id="call-@elementId" class="accordion-collapse collapse" data-bs-parent="#diagnosticsAccordion">
                            <div class="accordion-body">
                                <dl class="row mb-2">
                                    <dt class="col-3 text-secondary">URL</dt>
                                    <dd class="col-9 text-break">@record.RequestUri</dd>

                                    <dt class="col-3 text-secondary">Status</dt>
                                    <dd class="col-9">
                                        @(record.ResponseStatusCode?.ToString() ?? "—") @record.ResponseReasonPhrase
                                    </dd>

                                    <dt class="col-3 text-secondary">Started</dt>
                                    <dd class="col-9">@record.StartedAtUtc?.ToLocalTime().ToString("HH:mm:ss.fff")</dd>

                                    <dt class="col-3 text-secondary">Duration</dt>
                                    <dd class="col-9">@FormatDuration(record.DurationMs)</dd>

                                    @if (record.AttemptNumber is not null)
                                    {
                                        <dt class="col-3 text-secondary">Attempt</dt>
                                        <dd class="col-9">#@record.AttemptNumber</dd>
                                    }

                                    @if (!string.IsNullOrEmpty(record.RetryReason))
                                    {
                                        <dt class="col-3 text-secondary">Retry reason</dt>
                                        <dd class="col-9">@record.RetryReason</dd>
                                    }

                                    @if (!string.IsNullOrEmpty(record.ExceptionMessage))
                                    {
                                        <dt class="col-3 text-secondary">Exception</dt>
                                        <dd class="col-9 text-danger">@record.ExceptionMessage</dd>
                                    }
                                </dl>

                                <div class="mb-3">
                                    <div class="text-secondary text-uppercase small mb-1">Request headers</div>
                                    <HeaderTable Headers="@record.RequestHeaders" />
                                </div>

                                @if (!string.IsNullOrWhiteSpace(record.RequestBody))
                                {
                                    <div class="mb-3">
                                        <div class="text-secondary text-uppercase small mb-1">Request body</div>
                                        <CodeBlock Code="@record.RequestBody" />
                                    </div>
                                }

                                <div class="mb-3">
                                    <div class="text-secondary text-uppercase small mb-1">Response headers</div>
                                    <HeaderTable Headers="@record.ResponseHeaders" />
                                </div>

                                @if (!string.IsNullOrWhiteSpace(record.ResponseBody))
                                {
                                    <div>
                                        <div class="text-secondary text-uppercase small mb-1">Response body</div>
                                        <CodeBlock Code="@record.ResponseBody" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DiagnosticsStore Store { get; set; } = default!;

    private static string MethodBadgeClass(string? method) => method?.ToUpperInvariant() switch
    {
        "GET" => "bg-blue-lt text-blue-fg",
        "POST" => "bg-green-lt text-green-fg",
        "PUT" => "bg-yellow-lt text-yellow-fg",
        "PATCH" => "bg-orange-lt text-orange-fg",
        "DELETE" => "bg-red-lt text-red-fg",
        _ => "bg-secondary-lt"
    };

    private static string StatusBadgeClass(HttpCallRecord record)
    {
        if (record.Succeeded == true)
        {
            return "bg-green text-white";
        }

        return record.ResponseStatusCode switch
        {
            >= 400 and < 500 => "bg-orange text-white",
            >= 500 => "bg-red text-white",
            _ => "bg-red text-white"
        };
    }

    private static string Label(HttpCallRecord record)
    {
        if (!string.IsNullOrEmpty(record.SourceMethod))
        {
            return record.SourceMethod!;
        }

        return Uri.TryCreate(record.RequestUri, UriKind.Absolute, out var uri)
            ? uri.AbsolutePath.TrimStart('/')
            : record.RequestUri ?? "(unknown)";
    }

    private static string FormatDuration(double? ms) => ms switch
    {
        null => "",
        < 1000 => $"{ms:0}ms",
        _ => $"{ms / 1000:0.00}s"
    };
}
