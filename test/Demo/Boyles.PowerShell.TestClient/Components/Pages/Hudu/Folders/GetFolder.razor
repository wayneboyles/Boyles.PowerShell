@page "/hudu/folders/get-folder"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetFolder</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetFolder</h2>
    <div class="text-secondary"><code>HuduClient.GetFolderAsync</code> — GET <code>/api/v1/folders/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Folder Id</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_folderId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@(_busy || _folderId is null)">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private int? _folderId;

    private async Task RunAsync()
    {
        if (_folderId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var result = await HuduConnection.Client!.GetFolderAsync(_folderId.Value);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
