@page "/hudu/folders/new-folder"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · NewFolder</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">NewFolder</h2>
    <div class="text-secondary"><code>HuduClient.NewFolderAsync</code> — POST <code>/api/v1/folders</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <EditForm Model="_model" OnValidSubmit="RunAsync">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_model.Name" />
                                <ValidationMessage For="() => _model.Name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Company Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.CompanyId" />
                                <ValidationMessage For="() => _model.CompanyId" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Parent folder Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.ParentFolderId" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Folder type</label>
                                <InputSelect class="form-select" @bind-Value="_model.FolderType">
                                    <option value="">(default: article)</option>
                                    <option value="article">article</option>
                                    <option value="photo">photo</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Icon</label>
                            <InputText class="form-control" @bind-Value="_model.Icon" placeholder="e.g. fas fa-folder" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_model.Description" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Execute
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly NewFolderModel _model = new();
    private bool _busy;
    private string? _error;
    private string? _resultJson;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var result = await HuduConnection.Client!.NewFolderAsync(_model);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class NewFolderModel
    {
        [Required]
        public string? Name { get; set; }

        [Required]
        public int? CompanyId { get; set; }

        public string? Icon { get; set; }
        public string? Description { get; set; }
        public int? ParentFolderId { get; set; }
        public string? FolderType { get; set; }
    }
}
