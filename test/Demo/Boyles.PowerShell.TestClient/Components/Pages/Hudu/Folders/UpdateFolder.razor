@page "/hudu/folders/update-folder"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · UpdateFolder</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">UpdateFolder</h2>
    <div class="text-secondary"><code>HuduClient.UpdateFolderAsync</code> — PUT <code>/api/v1/folders/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Folder Id</label>
                        <input type="number" class="form-control" style="width: 160px;" @bind="_folderId" />
                    </div>
                    <EditForm Model="_model" OnValidSubmit="RunAsync">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_model.Name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Company Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.CompanyId" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Parent folder Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.ParentFolderId" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Folder type</label>
                                <InputSelect class="form-select" @bind-Value="_model.FolderType">
                                    <option value="">(unchanged)</option>
                                    <option value="article">article</option>
                                    <option value="photo">photo</option>
                                </InputSelect>
                                <div class="form-hint">Must match the folder's current type - Hudu rejects a change.</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Icon</label>
                            <InputText class="form-control" @bind-Value="_model.Icon" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_model.Description" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@(_busy || _folderId is null)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Execute
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly UpdateFolderModel _model = new();
    private int? _folderId;
    private bool _busy;
    private string? _error;
    private string? _resultJson;

    private async Task RunAsync()
    {
        if (_folderId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var result = await HuduConnection.Client!.UpdateFolderAsync(_folderId.Value, _model);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class UpdateFolderModel
    {
        public string? Name { get; set; }
        public string? Icon { get; set; }
        public string? Description { get; set; }
        public int? ParentFolderId { get; set; }
        public int? CompanyId { get; set; }
        public string? FolderType { get; set; }
    }
}
