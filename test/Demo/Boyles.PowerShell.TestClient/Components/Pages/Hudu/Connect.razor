@page "/hudu/connect"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · Connect</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">Hudu — Connect</h2>
    <div class="text-secondary">Builds a HuduClient wired to this app's Diagnostics panel.</div>
</div>

<div class="row row-cards">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <EditForm Model="_model" OnValidSubmit="ConnectAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Base URL</label>
                        <InputText class="form-control" @bind-Value="_model.BaseUrl" placeholder="https://your-instance.huducloud.com" />
                        <ValidationMessage For="() => _model.BaseUrl" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API key</label>
                        <InputText type="password" class="form-control" @bind-Value="_model.ApiKey" placeholder="x-api-key value" />
                        <ValidationMessage For="() => _model.ApiKey" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Connect
                        </button>
                        @if (HuduConnection.IsConnected)
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="Disconnect">Disconnect</button>
                        }
                    </div>
                </EditForm>

                @if (_error is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_error</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Status</h3>
                @if (HuduConnection.IsConnected)
                {
                    <div class="mb-2"><span class="badge bg-success-lt"><i class="ti ti-plug-connected me-1"></i>Connected</span></div>
                    <div class="text-secondary">@HuduConnection.BaseUrl</div>
                }
                else
                {
                    <span class="badge bg-secondary-lt"><i class="ti ti-plug-connected-x me-1"></i>Not connected</span>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ConnectModel _model = new();
    private bool _busy;
    private string? _error;

    private async Task ConnectAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Task.Run(() => HuduConnection.Connect(_model.BaseUrl!, _model.ApiKey!));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Disconnect() => HuduConnection.Disconnect();

    private sealed class ConnectModel
    {
        [Required]
        public string? BaseUrl { get; set; }

        [Required]
        public string? ApiKey { get; set; }
    }
}
