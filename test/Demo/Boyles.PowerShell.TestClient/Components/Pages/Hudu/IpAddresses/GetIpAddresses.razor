@page "/hudu/ip-addresses/get-ip-addresses"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetIpAddresses</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetIpAddresses</h2>
    <div class="text-secondary"><code>HuduClient.GetIpAddressesAsync</code> — paginated GET <code>/api/v1/ip_addresses</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Network Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_networkId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Address (optional)</label>
                    <input class="form-control" @bind="_address" placeholder="e.g. 10.0.0.10" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Status (optional)</label>
                    <select class="form-select" @bind="_status">
                        <option value="">(any)</option>
                        <option value="Assigned">Assigned</option>
                        <option value="Reserved">Reserved</option>
                        <option value="DHCP">DHCP</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">Fqdn (optional)</label>
                    <input class="form-control" @bind="_fqdn" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Asset Id (optional)</label>
                    <input type="number" class="form-control" style="width: 140px;" @bind="_assetId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Company Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_companyId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private int? _networkId;
    private string? _address;
    private string? _status;
    private string? _fqdn;
    private int? _assetId;
    private int? _companyId;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (_networkId is not null)
            {
                query["network_id"] = _networkId.Value.ToString();
            }

            if (!string.IsNullOrWhiteSpace(_address))
            {
                query["address"] = _address;
            }

            if (!string.IsNullOrWhiteSpace(_status))
            {
                query["status"] = _status;
            }

            if (!string.IsNullOrWhiteSpace(_fqdn))
            {
                query["fqdn"] = _fqdn;
            }

            if (_assetId is not null)
            {
                query["asset_id"] = _assetId.Value.ToString();
            }

            if (_companyId is not null)
            {
                query["company_id"] = _companyId.Value.ToString();
            }

            var result = await HuduConnection.Client!.GetIpAddressesAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
