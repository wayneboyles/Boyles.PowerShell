@page "/hudu/label-types/delete-label-type"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · DeleteLabelType</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">DeleteLabelType</h2>
    <div class="text-secondary"><code>HuduClient.DeleteLabelTypeAsync</code> — DELETE <code>/api/v1/label_types/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Label type Id</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_labelTypeId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-danger" @onclick="RunAsync" disabled="@(_busy || _labelTypeId is null)">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_busy)
    {
        <div class="text-secondary">Running…</div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_deleted)
    {
        <div class="alert alert-success">Label type @_labelTypeId deleted.</div>
    }
}

@code {
    private bool _busy;
    private bool _deleted;
    private string? _error;
    private int? _labelTypeId;

    private async Task RunAsync()
    {
        if (_labelTypeId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _deleted = false;
        try
        {
            await HuduConnection.Client!.DeleteLabelTypeAsync(_labelTypeId.Value);
            _deleted = true;
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
