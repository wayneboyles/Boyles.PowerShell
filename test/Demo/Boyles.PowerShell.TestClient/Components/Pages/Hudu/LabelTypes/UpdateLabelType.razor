@page "/hudu/label-types/update-label-type"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · UpdateLabelType</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">UpdateLabelType</h2>
    <div class="text-secondary"><code>HuduClient.UpdateLabelTypeAsync</code> — PUT <code>/api/v1/label_types/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Label type Id</label>
                        <input type="number" class="form-control" style="width: 160px;" @bind="_labelTypeId" />
                    </div>
                    <EditForm Model="_model" OnValidSubmit="RunAsync">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_model.Name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Color</label>
                                <InputSelect class="form-select" @bind-Value="_model.Color">
                                    <option value="">(unchanged)</option>
                                    <option value="Red">Red</option>
                                    <option value="Blue">Blue</option>
                                    <option value="Green">Green</option>
                                    <option value="Yellow">Yellow</option>
                                    <option value="Purple">Purple</option>
                                    <option value="Orange">Orange</option>
                                    <option value="Light Pink">Light Pink</option>
                                    <option value="Light Blue">Light Blue</option>
                                    <option value="Light Green">Light Green</option>
                                    <option value="Light Purple">Light Purple</option>
                                    <option value="Light Orange">Light Orange</option>
                                    <option value="Light Yellow">Light Yellow</option>
                                    <option value="White">White</option>
                                    <option value="Grey">Grey</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Access level</label>
                            <InputSelect class="form-select" @bind-Value="_model.AccessLevel">
                                <option value="">(unchanged)</option>
                                <option value="all_companies">all_companies</option>
                                <option value="specific_companies">specific_companies</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Applicable record types (comma-separated)</label>
                            <InputText class="form-control" @bind-Value="_applicableRecordTypes" placeholder="e.g. Article, Asset" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@(_busy || _labelTypeId is null)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Execute
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly UpdateLabelTypeModel _model = new();
    private string? _applicableRecordTypes;
    private int? _labelTypeId;
    private bool _busy;
    private string? _error;
    private string? _resultJson;

    private async Task RunAsync()
    {
        if (_labelTypeId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            _model.ApplicableRecordTypes = string.IsNullOrWhiteSpace(_applicableRecordTypes)
                ? null
                : _applicableRecordTypes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var result = await HuduConnection.Client!.UpdateLabelTypeAsync(_labelTypeId.Value, _model);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class UpdateLabelTypeModel
    {
        public string? Name { get; set; }
        public string? Color { get; set; }
        public string? AccessLevel { get; set; }
        public List<string>? ApplicableRecordTypes { get; set; }
    }
}
