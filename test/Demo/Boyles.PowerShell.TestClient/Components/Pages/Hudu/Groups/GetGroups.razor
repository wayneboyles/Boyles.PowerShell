@page "/hudu/groups/get-groups"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetGroups</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetGroups</h2>
    <div class="text-secondary"><code>HuduClient.GetGroupsAsync</code> — paginated GET <code>/api/v1/groups</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Name (optional)</label>
                    <input class="form-control" @bind="_name" placeholder="e.g. Technicians" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Search (optional)</label>
                    <input class="form-control" @bind="_search" />
                </div>
                <div class="col-auto form-check pt-4">
                    <input class="form-check-input" type="checkbox" id="defaultFilter" @bind="_defaultOnly" />
                    <label class="form-check-label" for="defaultFilter">Default group only</label>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private string? _name;
    private string? _search;
    private bool _defaultOnly;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (!string.IsNullOrWhiteSpace(_name))
            {
                query["name"] = _name;
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query["search"] = _search;
            }

            if (_defaultOnly)
            {
                query["default"] = "true";
            }

            var result = await HuduConnection.Client!.GetGroupsAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
