@page "/hudu/flags/get-flag"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetFlag</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetFlag</h2>
    <div class="text-secondary"><code>HuduClient.GetFlagAsync</code> — GET <code>/api/v1/flags/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Flag Id</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_flagId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@(_busy || _flagId is null)">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private int? _flagId;

    private async Task RunAsync()
    {
        if (_flagId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var result = await HuduConnection.Client!.GetFlagAsync(_flagId.Value);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
