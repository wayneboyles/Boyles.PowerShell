@page "/hudu/flags/get-flags"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetFlags</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetFlags</h2>
    <div class="text-secondary"><code>HuduClient.GetFlagsAsync</code> — paginated GET <code>/api/v1/flags</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Flag type Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_flagTypeId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Flagable Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_flagableId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Description (optional)</label>
                    <input class="form-control" @bind="_description" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private int? _flagTypeId;
    private int? _flagableId;
    private string? _description;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (_flagTypeId is not null)
            {
                query["flag_type_id"] = _flagTypeId.Value.ToString();
            }

            if (_flagableId is not null)
            {
                query["flagable_id"] = _flagableId.Value.ToString();
            }

            if (!string.IsNullOrWhiteSpace(_description))
            {
                query["description"] = _description;
            }

            var result = await HuduConnection.Client!.GetFlagsAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
