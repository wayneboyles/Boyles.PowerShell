@page "/hudu/networks/get-networks"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetNetworks</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetNetworks</h2>
    <div class="text-secondary"><code>HuduClient.GetNetworksAsync</code> — paginated GET <code>/api/v1/networks</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Name (optional)</label>
                    <input class="form-control" @bind="_name" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Slug (optional)</label>
                    <input class="form-control" @bind="_slug" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Address (optional)</label>
                    <input class="form-control" @bind="_address" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Company Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_companyId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Location Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_locationId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Network type (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_networkType" />
                </div>
                <div class="col-auto form-check pt-4">
                    <input class="form-check-input" type="checkbox" id="archivedFilter" @bind="_archived" />
                    <label class="form-check-label" for="archivedFilter">Archived only</label>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private string? _name;
    private string? _slug;
    private string? _address;
    private int? _companyId;
    private int? _locationId;
    private int? _networkType;
    private bool _archived;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (!string.IsNullOrWhiteSpace(_name))
            {
                query["name"] = _name;
            }

            if (!string.IsNullOrWhiteSpace(_slug))
            {
                query["slug"] = _slug;
            }

            if (!string.IsNullOrWhiteSpace(_address))
            {
                query["address"] = _address;
            }

            if (_companyId is not null)
            {
                query["company_id"] = _companyId.Value.ToString();
            }

            if (_locationId is not null)
            {
                query["location_id"] = _locationId.Value.ToString();
            }

            if (_networkType is not null)
            {
                query["network_type"] = _networkType.Value.ToString();
            }

            if (_archived)
            {
                query["archived"] = "true";
            }

            var result = await HuduConnection.Client!.GetNetworksAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
