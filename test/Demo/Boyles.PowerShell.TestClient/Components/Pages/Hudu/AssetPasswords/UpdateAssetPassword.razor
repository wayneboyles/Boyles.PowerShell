@page "/hudu/asset-passwords/update-asset-password"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · UpdateAssetPassword</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">UpdateAssetPassword</h2>
    <div class="text-secondary"><code>HuduClient.UpdateAssetPasswordAsync</code> — PUT <code>/api/v1/asset_passwords/{id}</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Asset Password Id</label>
                        <input type="number" class="form-control" style="width: 160px;" @bind="_passwordId" />
                    </div>
                    <EditForm Model="_model" OnValidSubmit="RunAsync">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_model.Name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Company Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.CompanyId" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Username</label>
                                <InputText class="form-control" @bind-Value="_model.Username" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Url</label>
                                <InputText class="form-control" @bind-Value="_model.Url" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_model.Description" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Passwordable type</label>
                                <InputText class="form-control" @bind-Value="_model.PasswordableType" placeholder="e.g. Asset" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Passwordable Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.PasswordableId" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password type</label>
                                <InputText class="form-control" @bind-Value="_model.PasswordType" placeholder="e.g. Password" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password folder Id</label>
                                <InputNumber class="form-control" @bind-Value="_model.PasswordFolderId" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">OTP secret</label>
                            <InputText class="form-control" @bind-Value="_model.OtpSecret" />
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_inPortal" />
                                <span class="form-check-label">Visible in portal</span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@(_busy || _passwordId is null)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Execute
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly UpdateAssetPasswordModel _model = new();
    private bool _inPortal;
    private int? _passwordId;
    private bool _busy;
    private string? _error;
    private string? _resultJson;

    private async Task RunAsync()
    {
        if (_passwordId is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            _model.InPortal = _inPortal;

            var result = await HuduConnection.Client!.UpdateAssetPasswordAsync(_passwordId.Value, _model);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class UpdateAssetPasswordModel
    {
        public string? Name { get; set; }
        public string? Password { get; set; }
        public int? CompanyId { get; set; }
        public string? PasswordableType { get; set; }
        public int? PasswordableId { get; set; }
        public bool? InPortal { get; set; }
        public string? OtpSecret { get; set; }
        public string? Url { get; set; }
        public string? Username { get; set; }
        public string? Description { get; set; }
        public string? PasswordType { get; set; }
        public int? PasswordFolderId { get; set; }
    }
}
