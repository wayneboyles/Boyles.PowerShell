@page "/hudu/lists/new-list"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · NewList</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">NewList</h2>
    <div class="text-secondary"><code>HuduClient.NewListAsync</code> — POST <code>/api/v1/lists</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <EditForm Model="_model" OnValidSubmit="RunAsync">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="_model.Name" />
                            <ValidationMessage For="() => _model.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">List items (one per line)</label>
                            <InputTextArea class="form-control" rows="6" @bind-Value="_model.Items" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Execute
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly NewListModel _model = new();
    private bool _busy;
    private string? _error;
    private string? _resultJson;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            // A dictionary keeps the wire key lower case; the builder does not snake_case POCO property names.
            var body = new Dictionary<string, object?> { ["name"] = _model.Name };

            var items = (_model.Items ?? string.Empty)
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(name => new HuduListItem { Name = name })
                .ToArray();

            var result = await HuduConnection.Client!.NewListAsync(body, items);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class NewListModel
    {
        [Required]
        public string? Name { get; set; }

        public string? Items { get; set; }
    }
}
