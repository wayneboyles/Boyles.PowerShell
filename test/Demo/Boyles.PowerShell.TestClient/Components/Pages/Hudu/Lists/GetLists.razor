@page "/hudu/lists/get-lists"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetLists</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetLists</h2>
    <div class="text-secondary"><code>HuduClient.GetListsAsync</code> — single GET <code>/api/v1/lists</code> (not paginated)</div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Name (optional)</label>
                    <input type="text" class="form-control" style="width: 240px;" @bind="_name" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Query (optional)</label>
                    <input type="text" class="form-control" style="width: 240px;" @bind="_query" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private string? _name;
    private string? _query;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (!string.IsNullOrWhiteSpace(_name))
            {
                query["name"] = _name;
            }

            if (!string.IsNullOrWhiteSpace(_query))
            {
                query["query"] = _query;
            }

            var result = await HuduConnection.Client!.GetListsAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
