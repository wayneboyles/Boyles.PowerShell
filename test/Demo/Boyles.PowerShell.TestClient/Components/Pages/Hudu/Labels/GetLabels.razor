@page "/hudu/labels/get-labels"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetLabels</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetLabels</h2>
    <div class="text-secondary"><code>HuduClient.GetLabelsAsync</code> — paginated GET <code>/api/v1/labels</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Label type Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_labelTypeId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Labelable Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_labelableId" />
                </div>
                <div class="col-auto">
                    <label class="form-label">User Id (optional)</label>
                    <input type="number" class="form-control" style="width: 160px;" @bind="_userId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private int? _labelTypeId;
    private int? _labelableId;
    private int? _userId;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            var query = new Dictionary<string, string>();

            if (_labelTypeId is not null)
            {
                query["label_type_id"] = _labelTypeId.Value.ToString();
            }

            if (_labelableId is not null)
            {
                query["labelable_id"] = _labelableId.Value.ToString();
            }

            if (_userId is not null)
            {
                query["user_id"] = _userId.Value.ToString();
            }

            var result = await HuduConnection.Client!.GetLabelsAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
