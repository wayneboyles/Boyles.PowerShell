@page "/hudu/activity-logs/get-activity-logs"
@inject HuduConnectionService HuduConnection

<PageTitle>Hudu · GetActivityLogs</PageTitle>

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">GetActivityLogs</h2>
    <div class="text-secondary"><code>HuduClient.GetActivityLogsAsync</code> — paginated GET <code>/api/v1/activity_logs</code></div>
</div>

@if (!HuduConnection.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a href="/hudu/connect">Connect to Hudu</a> first.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">User email (optional)</label>
                    <input class="form-control" @bind="_userEmail" placeholder="e.g. tech@example.com" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Action message (optional)</label>
                    <input class="form-control" @bind="_actionMessage" placeholder="e.g. created" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Resource type (optional)</label>
                    <input class="form-control" @bind="_resourceType" placeholder="e.g. Asset" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Resource Id (optional)</label>
                    <input type="number" class="form-control" style="width: 140px;" @bind="_resourceId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Execute
                    </button>
                </div>
            </div>
            <div class="form-hint mt-2">Resource type and resource Id must be supplied together, matching Get-HuduActivityLogs.</div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <ResultBlock Busy="@_busy" Error="@_error" Json="@_resultJson" />
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _resultJson;
    private string? _userEmail;
    private string? _actionMessage;
    private string? _resourceType;
    private int? _resourceId;

    private async Task RunAsync()
    {
        _busy = true;
        _error = null;
        _resultJson = null;
        try
        {
            if ((_resourceId is not null) != !string.IsNullOrWhiteSpace(_resourceType))
            {
                throw new InvalidOperationException("Resource type and resource Id must be supplied together.");
            }

            var query = new Dictionary<string, string>();

            if (!string.IsNullOrWhiteSpace(_userEmail))
            {
                query["user_email"] = _userEmail;
            }

            if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                query["action_message"] = _actionMessage;
            }

            if (!string.IsNullOrWhiteSpace(_resourceType) && _resourceId is not null)
            {
                query["resource_type"] = _resourceType;
                query["resource_id"] = _resourceId.Value.ToString();
            }

            var result = await HuduConnection.Client!.GetActivityLogsAsync(query.Count > 0 ? query : null);
            _resultJson = JsonConvert.SerializeObject(result, Formatting.Indented);
        }
        catch (ApiException ex)
        {
            _error = $"HTTP {(int)ex.StatusCode} {ex.StatusCode}\n{ex.ResponseBody}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
